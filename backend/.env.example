# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tulips:CHANGE_ME@localhost:5432/tulipsedu

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

DEBUG=false
BASE_DOMAIN=tulipsedu.in
APP_BASE_URL=https://admin.tulipsedu.in

# ── CORS ─────────────────────────────────────────────────────────────────────
# Production: use regex to allow all tenant subdomains
CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.tulipsedu\.in
# OR list specific origins (comma-separated):
# CORS_ORIGINS=https://school1.tulipsedu.in,https://school2.tulipsedu.in

# ── Cloudflare R2 (file uploads) ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=tulipsedu-uploads
R2_PUBLIC_URL=https://cdn.tulipsedu.in
